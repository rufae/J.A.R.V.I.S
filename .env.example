# ─────────────────────────────────────────────────────────────────────────────
# JARVIS Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Audio / Clap Detection ────────────────────────────────────────────────────
# Set to true to use simulated audio (no microphone required, useful for CI).
JARVIS_SIMULATED_AUDIO=false
# Amplitude threshold for clap detection (0.0 – 1.0).
JARVIS_CLAP_THRESHOLD=0.35
# Time window in seconds to detect two claps.
JARVIS_CLAP_WINDOW_SECONDS=1.5

# ── Voice Recognition ─────────────────────────────────────────────────────────
# Backend to use: vosk | faster-whisper | auto
JARVIS_VOICE_BACKEND=auto
# Absolute path to the Vosk model directory (required when using vosk backend).
# Download a model from https://alphacephei.com/vosk/models
JARVIS_VOSK_MODEL_PATH=
# Faster-Whisper model size: tiny | base | small | medium | large-v2
JARVIS_FASTER_WHISPER_MODEL=small
# Device for faster-whisper inference: cpu | cuda
JARVIS_FASTER_WHISPER_DEVICE=cpu
# Compute type for faster-whisper: int8 | float16 | float32
JARVIS_FASTER_WHISPER_COMPUTE_TYPE=int8
# Enable Voice Activity Detection (VAD) filter.
JARVIS_VAD_ENABLED=true
# Amplitude threshold to detect speech (faster-whisper fallback VAD).
JARVIS_VAD_SPEECH_THRESHOLD=0.015
# Seconds of silence before stopping capture.
JARVIS_SILENCE_TIMEOUT_SECONDS=2.5
# Maximum listen duration in seconds.
JARVIS_MAX_LISTEN_SECONDS=10.0
# Fall back to stdin input when no ASR backend is available (useful for testing).
JARVIS_STDIN_FALLBACK=true
# Default command injected in demo/test mode when no real input is available.
JARVIS_DEMO_COMMAND=what can you do

# ── Text-to-Speech ────────────────────────────────────────────────────────────
# Enable or disable TTS output.
JARVIS_ENABLE_TTS=true
# TTS backend: kokoro | piper | pyttsx3
JARVIS_TTS_BACKEND=pyttsx3
# Speech rate (words per minute, used by pyttsx3).
JARVIS_TTS_RATE=180
# Volume level (0.0 – 1.0, used by pyttsx3).
JARVIS_TTS_VOLUME=0.9
# Stream speech sentence-by-sentence (reduces latency for long responses).
JARVIS_TTS_STREAM_SENTENCES=true
# Kokoro voice ID (only relevant when backend=kokoro).
JARVIS_KOKORO_VOICE=af_heart
# Kokoro language code (only relevant when backend=kokoro).
JARVIS_KOKORO_LANG_CODE=a
# Absolute path to the Piper ONNX model file (required when backend=piper).
JARVIS_PIPER_MODEL_PATH=
# Path to the piper binary (must be on PATH or absolute).
JARVIS_PIPER_BINARY=piper

# ── UI Dashboard ──────────────────────────────────────────────────────────────
# Enable or disable the Flask web dashboard.
JARVIS_ENABLE_UI=true
# Host to bind the dashboard server to.
JARVIS_UI_HOST=127.0.0.1
# Port for the dashboard server.
JARVIS_UI_PORT=5050

# ── Ollama / LLM Agent ────────────────────────────────────────────────────────
# Enable the Ollama-based AI agent brain.
JARVIS_OLLAMA_ENABLED=true
# Ollama server base URL.
JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model name to use (must be pulled in Ollama: `ollama pull llama3.1:8b`).
JARVIS_OLLAMA_MODEL=llama3.1:8b
# Request timeout in seconds for Ollama API calls.
JARVIS_OLLAMA_TIMEOUT_SECONDS=120
# Sampling temperature (lower = more deterministic).
JARVIS_OLLAMA_TEMPERATURE=0.2
# Maximum planning steps the agent may take per request.
JARVIS_AGENT_MAX_PLANNING_STEPS=4

# ── System Safety ─────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
JARVIS_LOG_LEVEL=INFO
# Safe mode: restrict dangerous system commands.
JARVIS_SAFE_MODE=true
# Allow the "shutdown system" voice command (set to true to enable).
JARVIS_ALLOW_SHUTDOWN=false

# ── Filesystem ────────────────────────────────────────────────────────────────
# Colon-separated list of directories JARVIS may read/write files within.
# Example: /home/user/Documents:/home/user/Desktop
JARVIS_ALLOWED_FILE_ROOTS=

# ── Media ─────────────────────────────────────────────────────────────────────
# Directory containing local mp3/wav music files.
JARVIS_MUSIC_DIR=jarvis/audio_assets/music

# ── Memory / Database ─────────────────────────────────────────────────────────
# Path to the SQLite database used for interaction history and tasks.
JARVIS_MEMORY_DB_PATH=jarvis_data/agent_memory.sqlite3

# ── Google Workspace Integration ──────────────────────────────────────────────
# Enable Google Calendar and Contacts integration.
JARVIS_GOOGLE_ENABLED=false
# Absolute path to the OAuth2 credentials JSON downloaded from Google Cloud Console.
JARVIS_GOOGLE_CREDENTIALS_PATH=
# Directory or base path where per-scope token files are stored.
# Defaults to the same directory as the credentials file when left empty.
JARVIS_GOOGLE_TOKEN_PATH=

# ── Calendar Watch Service ───────────────────────────────────────────────────
# Enable background calendar event reminder service.
JARVIS_ENABLE_CALENDAR_WATCH=true
# How often to poll for upcoming events (seconds, minimum 30).
JARVIS_CALENDAR_POLL_SECONDS=120
# Announce reminders for events starting within this many minutes.
JARVIS_REMINDER_WINDOW_MINUTES=15

# ── Task Engine ───────────────────────────────────────────────────────────────
# Maximum retry attempts for background agent tasks.
JARVIS_TASK_MAX_ATTEMPTS=3
# Delay between retry attempts in seconds.
JARVIS_TASK_RETRY_DELAY_SECONDS=5
